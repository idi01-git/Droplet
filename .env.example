# Droplet Environment Variables

# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Storage Configuration
# Options: 'local' (development filesystem) or 'r2' / 's3' (production object storage)
STORAGE_DRIVER=local
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Quota & Circuit Breaker Overrides (Optional - defaults in shared/limits.ts)
# CIRCUIT_BREAKER_STORAGE_BYTES=1073741824
# ROOM_LIFETIME_MS=86400000

# Cloudflare R2 / S3 Configuration (Required if STORAGE_DRIVER=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=droplet-files
