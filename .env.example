# Droplet Environment Variables

# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Storage Configuration
# Options: 'local' (development filesystem) or 's3' (production AWS S3 / Cloudflare R2)
STORAGE_DRIVER=local
DATA_DIR=./data
UPLOAD_DIR=./uploads

# AWS S3 Configuration (Required if STORAGE_DRIVER=s3)
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-droplet-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_ENDPOINT=   # Optional (only needed for S3-compatible providers like MinIO or Cloudflare R2)

# Quota & Circuit Breaker Overrides (Optional - defaults in shared/limits.ts)
# CIRCUIT_BREAKER_STORAGE_BYTES=1073741824
# ROOM_LIFETIME_MS=86400000
