# ================================================================================
# Droplet Environment Variables
# ================================================================================

# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# --------------------------------------------------------------------------------
# Serverless SQLite Configuration (Turso / LibSQL) - Highly Recommended for Render
# --------------------------------------------------------------------------------
# If provided, Droplet connects to a serverless Turso SQLite database over HTTP/WebSocket.
# This makes your rooms, items, and sessions 100% persistent across Render redeployments!
# If omitted or left blank, Droplet automatically falls back to local SQLite file (./data/droplet.sqlite3).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --------------------------------------------------------------------------------
# Storage Configuration
# --------------------------------------------------------------------------------
# Options: 'local' (ephemeral container filesystem) or 's3' (production AWS S3 / Cloudflare R2)
# When 's3' is active, uploads and downloads bypass Render completely and stream
# directly from S3/R2 edge networks at 100-500+ Mbps line speed!
STORAGE_DRIVER=local
DATA_DIR=./data
UPLOAD_DIR=./uploads

# --------------------------------------------------------------------------------
# AWS S3 Configuration (Used if STORAGE_DRIVER=s3)
# --------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-droplet-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_ENDPOINT=   # Leave blank for standard AWS S3

# --------------------------------------------------------------------------------
# Cloudflare R2 Configuration (Alternative to AWS S3 - $0 Bandwidth Egress Fees!)
# --------------------------------------------------------------------------------
# Cloudflare R2 has ZERO egress bandwidth fees. To use R2 instead of AWS S3:
# Set STORAGE_DRIVER=s3 and provide either the AWS_* or R2_* variables below:
# R2_BUCKET_NAME=droplet-storage
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com

# --------------------------------------------------------------------------------
# Required S3 / R2 Bucket CORS Policy
# --------------------------------------------------------------------------------
# For direct browser uploads to work, add this CORS configuration to your S3/R2 bucket:
# [
#   {
#     "AllowedHeaders": ["*"],
#     "AllowedMethods": ["GET", "PUT", "HEAD"],
#     "AllowedOrigins": ["https://droplet.uno", "http://localhost:5173"],
#     "ExposeHeaders": ["ETag"]
#   }
# ]

# --------------------------------------------------------------------------------
# Quota & Circuit Breaker Overrides (Optional - defaults in shared/limits.ts)
# --------------------------------------------------------------------------------
# CIRCUIT_BREAKER_STORAGE_BYTES=1073741824
# ROOM_LIFETIME_MS=86400000
